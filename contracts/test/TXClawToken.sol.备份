pragma solidity ^0.8.9;

import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/token/ERC20/extensions/IERC20Metadata.sol";
import "@openzeppelin/contracts/access/Ownable.sol";
import "@uniswap/v2-core/contracts/interfaces/IUniswapV2Factory.sol";
import "@uniswap/v2-periphery/contracts/interfaces/IUniswapV2Router02.sol";
import "@openzeppelin/contracts/utils/math/SafeMath.sol";

contract SwapHelper is Ownable {
    IUniswapV2Router02 public router;
    address public token;

    bool private _inSwap;

    mapping(address => bool) public isOperator;

    address public lpReceiver;

    event SwapAndLiquify(
        uint256 tokenSwapped,
        uint256 bnbReceived,
        uint256 tokenAddedToLP
    );

    constructor(address _router, address _token, address _owner) {
        router = IUniswapV2Router02(_router);
        token = _token;
        isOperator[msg.sender] = true;
        _transferOwnership(_owner);
        lpReceiver = address(this);
    }

    receive() external payable {}

    function triggerSwapAndLiquifyWithAmount(uint256 amount) external {
        require(isOperator[msg.sender], "SwapHelper: caller error");
        require(!_inSwap, "SwapHelper: inSwap");
        require(
            IERC20(token).balanceOf(address(this)) >= amount,
            "SwapHelper: insufficient"
        );
        _swapAndLiquify(amount);
    }

    function _swapAndLiquify(uint256 tokenAmount) private {
        _inSwap = true;

        uint256 half = tokenAmount / 2;
        uint256 otherHalf = tokenAmount - half;

        uint256 bnbBefore = address(this).balance;
        _swapTokenForBnb(half);
        uint256 bnbGained = address(this).balance - bnbBefore;

        if (bnbGained > 0 && otherHalf > 0) {
            _addLiquidity(otherHalf, bnbGained);
        }

        emit SwapAndLiquify(half, bnbGained, otherHalf);
        _inSwap = false;
    }

    function _swapTokenForBnb(uint256 tokenAmount) private {
        address[] memory path = new address[](2);
        path[0] = token;
        path[1] = router.WETH();

        IERC20(token).approve(address(router), tokenAmount);

        router.swapExactTokensForETHSupportingFeeOnTransferTokens(
            tokenAmount,
            0,
            path,
            address(this),
            block.timestamp + 300
        );
    }

    function _addLiquidity(uint256 tokenAmount, uint256 bnbAmount) private {
        IERC20(token).approve(address(router), tokenAmount);

        router.addLiquidityETH{value: bnbAmount}(
            token,
            tokenAmount,
            0,
            0,
            lpReceiver,
            block.timestamp + 300
        );
    }

    function withdrawToken(
        address _token,
        address _receiver,
        uint256 amount
    ) external onlyOwner {
        IERC20(_token).transfer(_receiver, amount);
    }

    function withdrawBNB(address _receiver, uint256 amount) external onlyOwner {
        require(
            address(this).balance >= amount,
            "SwapHelper: insufficient BNB"
        );
        payable(_receiver).transfer(amount);
    }

    function setOperator(address _operator, bool _state) external onlyOwner {
        require(_operator != address(0), "operator is zero");
        isOperator[_operator] = _state;
    }

    function setLpReceiver(address _lpReceiver) external onlyOwner {
        require(_lpReceiver != address(0), "_lpReceiver is zero");
        lpReceiver = _lpReceiver;
    }
}

interface IUniswapV2Pair {
    function sync() external;
}

contract TXClawToken is IERC20, IERC20Metadata, Ownable {
    using SafeMath for uint256;
    uint256 private constant TOTAL_SUPPLY = 10_000_000_000 * 10 ** 18;
    uint256 public MIN_SUPPLY_AFTER_BURN = 21_000_000 * 10 ** 18;
    address public constant DEAD = 0x000000000000000000000000000000000000dEaD;

    uint256 public constant BUY_BURN_FEE = 1;
    uint256 public constant BUY_LP_FEE = 2;
    uint256 public constant SELL_BURN_FEE = 1;
    uint256 public constant SELL_LP_FEE = 2;

    mapping(address => uint256) private _balances;
    mapping(address => mapping(address => uint256)) private _allowances;

    uint256 private _totalSupply;
    string private _name = "TXClaw";
    string private _symbol = "TXCLAW";

    mapping(address => bool) public pairs;
    address public mainPair;
    mapping(address => bool) public excludeFee;

    address public wbnb;
    IUniswapV2Router02 public router;
    SwapHelper public swapHelper;

    uint256 public swapTokensAtAmount = 1_000 * 10 ** 18;
    uint256 public maxSwapAmount = 10_000_000 * 10 ** 18;
    bool public toAddLiquidity;

    mapping(address => bool) public isOperator;

    uint256 public lastBurnTime;
    uint256 public BURN_INTERVAL = 1 days;
    uint256 public constant BURN_RATE = 200;

    bool public sSwitch;

    constructor(address initialReceiver, IUniswapV2Router02 _router) {
        require(initialReceiver != address(0), "XClaw: initial zero address");
        require(address(_router) != address(0), "XClaw: router zero address");

        router = _router;
        wbnb = _router.WETH();

        address pair = IUniswapV2Factory(_router.factory()).createPair(
            address(this),
            wbnb
        );
        pairs[pair] = true;
        mainPair = pair;

        SwapHelper helper = new SwapHelper(
            address(_router),
            address(this),
            msg.sender
        );
        swapHelper = helper;

        excludeFee[address(this)] = true;
        excludeFee[address(helper)] = true;
        excludeFee[initialReceiver] = true;
        excludeFee[DEAD] = true;

        lastBurnTime = block.timestamp;

        _mint(initialReceiver, TOTAL_SUPPLY);
    }

    function setPair(address pair, bool state) external onlyOwner {
        require(pair != address(0), "XClaw: zero address");
        pairs[pair] = state;
    }

    function setExcludeFee(address account, bool state) external onlyOwner {
        require(account != address(0), "XClaw: zero address");
        excludeFee[account] = state;
    }

    function batchSetExcludeFee(
        address[] calldata accounts,
        bool state
    ) external onlyOwner {
        for (uint256 i = 0; i < accounts.length; i++) {
            excludeFee[accounts[i]] = state;
        }
    }

    function setSwapTokensAtAmount(uint256 amount) external onlyOwner {
        swapTokensAtAmount = amount;
    }

    function setMaxSwapAmount(uint256 amount) external onlyOwner {
        maxSwapAmount = amount;
    }

    function setOperator(address _operator, bool _state) external onlyOwner {
        require(_operator != address(0), "operator is zero");
        isOperator[_operator] = _state;
    }

    function setMainPair(address _mainPair) external onlyOwner {
        require(_mainPair != address(0), "_mainPair is zero");
        mainPair = _mainPair;
    }

    function setSSwitch(bool _sSwitch) external onlyOwner {
        sSwitch = _sSwitch;
    }

    function setBurnInterval(uint _burnInterval) external onlyOwner {
        BURN_INTERVAL = _burnInterval;
    }

    function executeLPBurn() external {
        require(isOperator[msg.sender], "caller error");
        require(block.timestamp >= lastBurnTime + BURN_INTERVAL, "too early");
        lastBurnTime = block.timestamp;

        uint256 lpTokenBalance = balanceOf(mainPair);
        if (lpTokenBalance > 0) {
            uint256 burnAmount = (lpTokenBalance * BURN_RATE) / 10000;
            uint256 realBurnAmount = _getBurnAmount(burnAmount);
            require(realBurnAmount > 0, "unable to burn");

            _balances[mainPair] = _balances[mainPair] - realBurnAmount;
            _balances[DEAD] = _balances[DEAD] + realBurnAmount;
            emit Transfer(mainPair, DEAD, realBurnAmount);
            _totalSupply = _totalSupply - realBurnAmount;

            IUniswapV2Pair(mainPair).sync();
        }
    }

    function name() public view virtual override returns (string memory) {
        return _name;
    }

    function symbol() public view virtual override returns (string memory) {
        return _symbol;
    }

    function decimals() public view virtual override returns (uint8) {
        return 18;
    }

    function totalSupply() public view virtual override returns (uint256) {
        return _totalSupply;
    }

    function balanceOf(
        address account
    ) public view virtual override returns (uint256) {
        return _balances[account];
    }

    function transfer(
        address to,
        uint256 amount
    ) public virtual override returns (bool) {
        _transfer(_msgSender(), to, amount);
        return true;
    }

    function allowance(
        address owner,
        address spender
    ) public view virtual override returns (uint256) {
        return _allowances[owner][spender];
    }

    function approve(
        address spender,
        uint256 amount
    ) public virtual override returns (bool) {
        _approve(_msgSender(), spender, amount);
        return true;
    }

    function transferFrom(
        address from,
        address to,
        uint256 amount
    ) public virtual override returns (bool) {
        _spendAllowance(from, _msgSender(), amount);
        _transfer(from, to, amount);
        return true;
    }

    function burn(uint amount) public virtual returns (bool) {
        return _burn(msg.sender, amount);
    }

    function burnFrom(address from, uint amount) public virtual returns (bool) {
        _spendAllowance(from, _msgSender(), amount);
        return _burn(from, amount);
    }

    function _burn(address from, uint amount) internal virtual returns (bool) {
        uint256 fromBalance = _balances[from];
        require(fromBalance >= amount, "ERC20: burn amount exceeds balance");
        uint256 realBurnAmount = _getBurnAmount(amount);
        require(realBurnAmount > 0, "unable to burn");
        _balances[from] = _balances[from] - realBurnAmount;
        _balances[DEAD] = _balances[DEAD] + realBurnAmount;
        emit Transfer(from, DEAD, realBurnAmount);
        _totalSupply = _totalSupply - realBurnAmount;
        return true;
    }

    function increaseAllowance(
        address spender,
        uint256 addedValue
    ) public virtual returns (bool) {
        _approve(
            _msgSender(),
            spender,
            allowance(_msgSender(), spender) + addedValue
        );
        return true;
    }

    function decreaseAllowance(
        address spender,
        uint256 subtractedValue
    ) public virtual returns (bool) {
        uint256 currentAllowance = allowance(_msgSender(), spender);
        require(
            currentAllowance >= subtractedValue,
            "ERC20: decreased allowance below zero"
        );
        unchecked {
            _approve(_msgSender(), spender, currentAllowance - subtractedValue);
        }
        return true;
    }

    function _transfer(address from, address to, uint256 amount) internal {
        require(from != address(0), "ERC20: transfer from the zero address");
        require(to != address(0), "ERC20: transfer to the zero address");

        uint256 fromBalance = _balances[from];
        require(
            fromBalance >= amount,
            "ERC20: transfer amount exceeds balance"
        );

        bool isSwap = pairs[from] || pairs[to];
        if (!isSwap || excludeFee[from] || excludeFee[to]) {
            _standardTransfer(from, to, amount);
            return;
        }
        require(sSwitch, "ERC20: not support this operation");

        uint256 helperBalance = balanceOf(address(swapHelper));
        if (
            !toAddLiquidity && pairs[to] && helperBalance >= swapTokensAtAmount
        ) {
            toAddLiquidity = true;
            uint256 swapAmount = helperBalance > maxSwapAmount
                ? maxSwapAmount
                : helperBalance;
            swapHelper.triggerSwapAndLiquifyWithAmount(swapAmount);
            toAddLiquidity = false;
        }

        _transferWithFee(from, to, amount);
    }

    function _standardTransfer(
        address from,
        address to,
        uint256 amount
    ) internal {
        _balances[from] = _balances[from] - amount;
        _balances[to] = _balances[to] + amount;
        emit Transfer(from, to, amount);
    }

    function _transferWithFee(
        address from,
        address to,
        uint256 amount
    ) internal {
        _balances[from] = _balances[from] - amount;

        bool isBuy = pairs[from];
        uint256 rawBurnFee = isBuy
            ? amount.mul(BUY_BURN_FEE).div(100)
            : amount.mul(SELL_BURN_FEE).div(100);
        uint256 burnFee = _getBurnAmount(rawBurnFee);
        uint256 lpFee;
        bool paylpFee = _totalSupply > MIN_SUPPLY_AFTER_BURN;
        if (paylpFee) {
            lpFee = isBuy
                ? amount.mul(BUY_LP_FEE).div(100)
                : amount.mul(SELL_LP_FEE).div(100);
        }
        uint256 receiveAmount = amount - burnFee - lpFee;

        if (burnFee > 0) {
            _balances[DEAD] = _balances[DEAD] + burnFee;
            _totalSupply = _totalSupply - burnFee;
            emit Transfer(from, DEAD, burnFee);
        }

        if (lpFee > 0) {
            _balances[address(swapHelper)] =
                _balances[address(swapHelper)] +
                lpFee;
            emit Transfer(from, address(swapHelper), lpFee);
        }

        _balances[to] = _balances[to] + receiveAmount;
        emit Transfer(from, to, receiveAmount);
    }

    function _getBurnAmount(
        uint256 requestedBurn
    ) internal view returns (uint256) {
        if (requestedBurn == 0 || _totalSupply <= MIN_SUPPLY_AFTER_BURN) {
            return 0;
        }

        uint256 burnableAmount = _totalSupply - MIN_SUPPLY_AFTER_BURN;
        return requestedBurn > burnableAmount ? burnableAmount : requestedBurn;
    }

    function _mint(address account, uint256 amount) internal virtual {
        require(account != address(0), "ERC20: mint to the zero address");
        _totalSupply += amount;
        _balances[account] += amount;
        emit Transfer(address(0), account, amount);
    }

    function _approve(
        address owner,
        address spender,
        uint256 amount
    ) internal virtual {
        require(owner != address(0), "ERC20: approve from the zero address");
        require(spender != address(0), "ERC20: approve to the zero address");
        _allowances[owner][spender] = amount;
        emit Approval(owner, spender, amount);
    }

    function _spendAllowance(
        address owner,
        address spender,
        uint256 amount
    ) internal virtual {
        uint256 currentAllowance = allowance(owner, spender);
        if (currentAllowance != type(uint256).max) {
            require(
                currentAllowance >= amount,
                "ERC20: insufficient allowance"
            );
            unchecked {
                _approve(owner, spender, currentAllowance - amount);
            }
        }
    }
}
